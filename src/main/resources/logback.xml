<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%gray(%d{HH:mm:ss.SSS}) %highlight(%-5level) %cyan(%logger{24}) - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.flywaydb" level="${gameq.flywayLogLevel:-INFO}"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
