#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

dependency_files=(
    build.gradle.kts
    settings.gradle.kts
    gradle/wrapper/gradle-wrapper.properties
    gradle/libs.versions.toml
)

if git diff --cached --quiet -- "${dependency_files[@]}"; then
    exit 0
fi

echo "Dependency files changed; running a refreshed build"
./gradlew --refresh-dependencies build
